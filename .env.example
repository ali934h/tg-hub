# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USERS=

# Absolute path where yt-dlp downloads files temporarily
DOWNLOAD_DIR=/root/tg-hub-downloads

# Maximum file size in MB the bot will try to upload to Telegram
MAX_UPLOAD_MB=2000

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ── Google Drive (optional) ──────────────────────────────────────────────────
# Run `node setup-drive.js` once to generate GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# ── Direct Link / Filehost (optional) ───────────────────────────────────────
# Domain must be on Cloudflare (orange cloud) with an Origin Server certificate.
# Nginx is configured by install.sh to serve files from FILEHOST_SERVE_DIR.
FILEHOST_DOMAIN=
FILEHOST_SERVE_DIR=/var/lib/tg-hub/files
FILEHOST_PORT=3000
# How many days to keep hosted files. 0 = keep forever.
FILEHOST_RETENTION_DAYS=0

# ── Gallery ──────────────────────────────────────────────────────────────────
# Temp dir for gallery image staging (cleaned up after each job).
GALLERY_TEMP_DIR=

# Optional SOCKS5 proxy for gallery strategies with "useProxy": true in
# src/gallery/config/siteStrategies.json.
# Format: socks5://[user:pass@]host:port
# Example: socks5://127.0.0.1:1080
GALLERY_PROXY_URL=

# Gallery scraping / download tuning (defaults are fine for most setups)
GALLERY_SCRAPE_TIMEOUT_MS=30000
GALLERY_SCRAPE_RETRIES=3
GALLERY_FALLBACK_STRATEGY_LIMIT=5
GALLERY_FALLBACK_MIN_IMAGES=5
GALLERY_DOWNLOAD_CONCURRENCY=5
GALLERY_DOWNLOAD_TIMEOUT_MS=60000
GALLERY_DOWNLOAD_RETRIES=3
