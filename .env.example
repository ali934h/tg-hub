# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Comma-separated Telegram user IDs allowed to use the bot (required, non-empty)
ALLOWED_USERS=

# Absolute path where downloaded files are temporarily stored
DOWNLOAD_DIR=/root/tg-hub-downloads

# Maximum file size in MB the bot will try to upload to Telegram (MTProto limit ~2000)
MAX_UPLOAD_MB=2000

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ── Google Drive (optional) ──────────────────────────────────────────────────
# If set, the bot will offer to upload downloaded files to Google Drive.
# Run `node setup-drive.js` once to generate GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: specific Drive folder ID to upload into (leave blank for root)
DRIVE_FOLDER_ID=
